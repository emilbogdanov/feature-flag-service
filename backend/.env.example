# For running the server outside Docker: copy to backend/.env. docker compose sets these itself.
FLAGSTAFF_DATABASE_URL=postgresql+asyncpg://flagstaff:flagstaff@localhost:5432/flagstaff
FLAGSTAFF_REDIS_URL=redis://localhost:6379/0
FLAGSTAFF_LOG_LEVEL=INFO
# json or text
FLAGSTAFF_LOG_FORMAT=text
# Keep-alive interval for SDK streams, and how often each instance double-checks the versions
# its streams hold against the database.
FLAGSTAFF_STREAM_HEARTBEAT_SECONDS=15
FLAGSTAFF_RULESET_RESYNC_SECONDS=30
# How long an instance trusts a key it authenticated, and a ruleset version it heard of.
FLAGSTAFF_KEY_CACHE_SECONDS=10
FLAGSTAFF_VERSION_CACHE_SECONDS=5
