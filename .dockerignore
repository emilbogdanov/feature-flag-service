# Images are built from the repository root, and only the server, the SDK and the lock file go in.
# The SDK's README and license are part of its package metadata, so building it needs them.
**
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/migrations/
!backend/src/
!sdk/pyproject.toml
!sdk/README.md
!sdk/LICENSE
!sdk/src/
**/__pycache__
